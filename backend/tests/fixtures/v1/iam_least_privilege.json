{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlySpecificPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::skynex-test-bucket",
        "arn:aws:s3:::skynex-test-bucket/reports/*"
      ],
      "Condition": {
        "StringEquals": { "s3:prefix": "reports/" }
      }
    }
  ]
}
